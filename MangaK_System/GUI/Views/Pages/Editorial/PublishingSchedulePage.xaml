<UserControl
    x:Class="MangaK_System.GUI.Views.Pages.Editorial.PublishingSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!--
    Màn hình Đặt & Quản lý Lịch Xuất Bản cho Editorial Board
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Approved series waiting to be scheduled -->
            <RowDefinition Height="Auto"/>
            <!-- Scheduled list -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section 1: Approved Series Waiting for Schedule -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,20"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Approved Series (Awaiting Schedule)"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1A1A2E"
                           Margin="0,0,0,12"/>

                <TextBlock Text="No approved series waiting to be scheduled."
                           Foreground="#9CA3AF"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApprovedSeriesList.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding ApprovedSeriesList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#1A1A2E"/>
                                        <TextBlock Text="{Binding MangakaName, StringFormat='Author: {0}'}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Set Schedule"
                                            Command="{Binding DataContext.ScheduleSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#9333EA"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="14,6"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Section 2: Active Publishing Schedules List -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Publishing Schedules"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#1A1A2E"
                       Margin="0,0,0,12"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding ScheduleList}"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="10"
                                Padding="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SeriesTitle}" FontSize="15" FontWeight="Bold" Foreground="#1A1A2E"/>
                                    <TextBlock Text="{Binding MangakaName, StringFormat='Author: {0}'}" FontSize="12" Foreground="#4B5563" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding PublishDate, StringFormat='Publish Date: {0:dd/MM/yyyy}'}" FontSize="12" FontWeight="SemiBold" Foreground="#9333EA" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding PublishPeriod, StringFormat='Period: {0}'}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#F3E8FF"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SeriesStatus}" FontSize="12" FontWeight="Bold" Foreground="#9333EA"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
