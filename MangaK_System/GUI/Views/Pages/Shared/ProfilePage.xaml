<UserControl
    x:Class="MangaK_System.GUI.Views.Pages.Shared.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!--
    Màn hình Xem thông tin cá nhân (Profile Read-Only theo BLL GetProfileAsync)
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="User Profile Information"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"
                   Margin="0,0,0,16"/>

        <!-- Card Container -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="28"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                MaxWidth="650"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Avatar & Header Info -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="70" Height="70"
                            CornerRadius="35"
                            Background="#7C5CBF"
                            Margin="0,0,20,0">
                        <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FirstName}" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LastName}" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Email}" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>

                        <Border Background="#F3E8FF" CornerRadius="12" Padding="10,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RoleName, StringFormat='Role: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#7C5CBF"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="#F3F4F6" Margin="0,0,0,20"/>

                <!-- Profile Read-Only Details Grid -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- First Name -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FIRST NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding FirstName}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A2E"/>
                    </StackPanel>

                    <!-- Last Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LAST NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LastName}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A2E"/>
                    </StackPanel>
                </Grid>

                <!-- Author / Pen Name -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="AUTHOR / PEN NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding AuthorName}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A2E"/>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="PHONE NUMBER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Phone}" FontSize="14" Foreground="#1A1A2E"/>
                </StackPanel>

                <!-- Bio -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="BIO / DESCRIPTION" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Bio}" FontSize="13" Foreground="#374151" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
