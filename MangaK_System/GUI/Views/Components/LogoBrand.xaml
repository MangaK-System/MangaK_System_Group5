<UserControl
    x:Class="MangaK_System.GUI.Views.Components.LogoBrand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════╗
    ║       COMPONENT: LogoBrand              ║
    ╚══════════════════════════════════════════╝
    Component hiển thị logo + tên thương hiệu "MangaK".
    Tái sử dụng ở cả LandingPage lẫn LoginPage.
    
    Layout: [Ảnh logo] [Manga][K] (chữ K màu cam)
    -->

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Icon logo từ file ảnh trong Resource -->
        <Image Source="/GUI/Resource/Logo.png"
               Width="32" Height="32"
               Stretch="Uniform"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

        <!-- Tên thương hiệu: "Manga" + "K" (K màu vàng/cam nhấn) -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Manga"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <TextBlock Text="K"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#F5A623"
                       VerticalAlignment="Center"/>
        </StackPanel>

    </StackPanel>
</UserControl>
