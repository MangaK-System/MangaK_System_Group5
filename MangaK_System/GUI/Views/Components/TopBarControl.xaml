<UserControl
    x:Class="MangaK_System.GUI.Views.Components.TopBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════╗
    ║         COMPONENT: TopBarControl (Header)               ║
    ╚══════════════════════════════════════════════════════════╝
    Thanh tiêu đề ngang trên cùng – kết hợp HeaderPage.jsx + HeaderMenu.jsx.

    Bố cục: [Avatar + "Welcome back!" + Role]  |  [Bell icon] [☰ Menu]

    Tính năng:
      - Avatar người dùng + tên role
      - Icon chuông với badge số feedback chưa đọc
      - Dropdown menu: Profile, Logout

    DataContext: TopBarViewModel
    -->

    <!-- Nền trắng, shadow dưới -->
    <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1"
            Padding="20,0">
        <Grid Height="56">
            <Grid.ColumnDefinitions>
                <!-- Phần trái: Avatar + Tên -->
                <ColumnDefinition Width="*"/>
                <!-- Phần phải: Bell + Menu -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ─── TRÁI: Avatar + Chào mừng ─── -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Avatar hình tròn -->
                <Border Width="38" Height="38"
                        CornerRadius="19"
                        BorderBrush="#7C5CBF"
                        BorderThickness="2"
                        Margin="0,0,12,0"
                        ClipToBounds="True">
                    <!-- Placeholder avatar (chữ tắt role) -->
                    <Border Background="#EDE9F8">
                        <TextBlock Text="👤"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Border>

                <!-- Chào mừng + Role -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Welcome back!"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"/>
                    <TextBlock Text="{Binding RoleName}"
                               FontSize="11"
                               Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>

            <!-- ─── PHẢI: Bell + Menu Dropdown ─── -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">



                <!--
                ═══════════════════════════════════════════
                DROPDOWN MENU (☰) – tương đương HeaderMenu.jsx
                Gồm: Profile, Logout
                ═══════════════════════════════════════════
                -->
                <Grid>
                    <!-- Nút hamburger menu -->
                    <Button Command="{Binding ToggleMenuDropdownCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Width="36" Height="36"
                            Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="menuBorder"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Width="36" Height="36">
                                    <TextBlock Text="☰"
                                               FontSize="16"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="menuBorder" Property="Background" Value="#F0EDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Popup dropdown menu -->
                    <Popup IsOpen="{Binding IsMenuDropdownOpen}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Width="200"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  Opacity="0.12"
                                                  BlurRadius="20"
                                                  ShadowDepth="6"
                                                  Direction="270"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Header dropdown -->
                                <Border Background="#F9FAFB"
                                        CornerRadius="12,12,0,0"
                                        Padding="14,10">
                                    <TextBlock Text="MENU"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"/>
                                </Border>

                                <!-- Divider -->
                                <Rectangle Height="1" Fill="#F3F4F6"/>

                                <!-- Mục Profile -->
                                <Button Command="{Binding GoToProfileCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="profileBorder"
                                                    Background="Transparent"
                                                    Padding="14,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#F3F4F6"
                                                            CornerRadius="6"
                                                            Width="30" Height="30"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="👤"
                                                                   FontSize="13"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Profile"
                                                               FontSize="13"
                                                               Foreground="#374151"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="profileBorder" Property="Background" Value="#F9FAFB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Divider -->
                                <Rectangle Height="1" Fill="#F3F4F6" Margin="14,0"/>

                                <!-- Mục Logout (màu đỏ) -->
                                <Button Command="{Binding LogoutCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="logoutBorder"
                                                    Background="Transparent"
                                                    CornerRadius="0,0,12,12"
                                                    Padding="14,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#FEF2F2"
                                                            CornerRadius="6"
                                                            Width="30" Height="30"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="🚪"
                                                                   FontSize="13"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Logout"
                                                               FontSize="13"
                                                               Foreground="#EF4444"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="logoutBorder" Property="Background" Value="#FFF5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
