<Window
    x:Class="MangaK_System.GUI.Views.Components.Dialogs.ReviewNoteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Series Review"
    Width="520"
    Height="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#F8F7FC">

    <!--
    Dialog Duyệt / Từ Chối Series bằng ghi chú text
    -->
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="SeriesTitleTextBlock"
                           Text="Review Series"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1A1A2E"/>
                <TextBlock Text="Enter feedback or notes for the author before submitting your decision."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Note Input -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="FEEDBACK NOTE (REQUIRED IF REJECTING)"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NoteTextBox"
                         Height="140"
                         FontSize="14"
                         Padding="10,8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="White"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"/>

                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="#EF4444"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Width="90" Height="38"
                        HorizontalAlignment="Left"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reject Series"
                            Width="120" Height="38"
                            Margin="0,0,10,0"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RejectButton_Click"/>

                    <Button Content="Approve Series"
                            Width="130" Height="38"
                            Background="#10B981"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ApproveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
