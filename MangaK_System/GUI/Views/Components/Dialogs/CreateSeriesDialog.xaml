<Window
    x:Class="MangaK_System.GUI.Views.Components.Dialogs.CreateSeriesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create New Series"
    Width="520"
    Height="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#F8F7FC">

    <!--
    Dialog Tạo Series mới cho Mangaka với tính năng Browse file từ máy tính
    -->
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Create New Manga Series"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1A1A2E"/>
                <TextBlock Text="Fill in details and select cover image and manuscript files to upload."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Title input -->
                <TextBlock Text="SERIES TITLE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TitleTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="10,6"
                         Background="White"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"
                         Margin="0,0,0,14"/>

                <!-- Description input -->
                <TextBlock Text="DESCRIPTION"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="DescriptionTextBox"
                         Height="85"
                         FontSize="13"
                         Padding="10,6"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="White"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"
                         Margin="0,0,0,14"/>

                <!-- Cover Image Browse -->
                <TextBlock Text="COVER IMAGE FILE (JPG, PNG, WEBP)"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CoverFileTextBox"
                             Grid.Column="0"
                             Height="38"
                             FontSize="13"
                             Padding="10,6"
                             IsReadOnly="True"
                             Background="#F9FAFB"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="90" Height="38"
                            Background="#E0E7FF"
                            Foreground="#4338CA"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BrowseCover_Click"/>
                </Grid>

                <!-- Manuscript File Browse -->
                <TextBlock Text="MANUSCRIPT FILE / NAME FILE (PDF, DOC, ZIP)"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NameFileTextBox"
                             Grid.Column="0"
                             Height="38"
                             FontSize="13"
                             Padding="10,6"
                             IsReadOnly="True"
                             Background="#F9FAFB"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="90" Height="38"
                            Background="#E0E7FF"
                            Foreground="#4338CA"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BrowseNameFile_Click"/>
                </Grid>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="#EF4444"
                           FontSize="12"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Width="100" Height="38"
                        Margin="0,0,12,0"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button Content="Create Series"
                        Width="130" Height="38"
                        Background="#7C5CBF"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CreateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
