<Window
    x:Class="MangaK_System.GUI.Views.Components.Dialogs.SeriesDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Series Details"
    Width="560"
    Height="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#F8F7FC">

    <!--
    Dialog hiển thị chi tiết Series (Title, Cover, Description, Status, Categories, Download NameFile)
    -->
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Series Title"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="AuthorAndDateTextBlock"
                               Text="Author: Akira Koba • Created: 01/01/2026"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1"
                        x:Name="StatusBorder"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Processing"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover Image -->
                        <Border Grid.Column="0"
                                Height="170"
                                CornerRadius="8"
                                Background="#EDE9F8"
                                ClipToBounds="True"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Grid>
                                <!-- Image Control -->
                                <Image x:Name="CoverImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Fallback Placeholder -->
                                <TextBlock x:Name="CoverFallbackTextBlock"
                                           Text="📚"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Right Info -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <!-- Category tags (Blank/Empty for now as specified) -->
                            <TextBlock Text="CATEGORIES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="CategoriesTextBlock"
                                       Text="(None)"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       Margin="0,0,0,16"/>

                            <!-- Manuscript / Name File Download -->
                            <TextBlock Text="MANUSCRIPT FILE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="DownloadFileButton"
                                        Content="📥 Download File"
                                        Background="#4F46E5"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="DownloadFileButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="FeedbackButton"
                                        Content="💬 Feedbacks"
                                        Background="#7C5CBF"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="12,6"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="FeedbackButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="NoFileTextBlock"
                                       Text="No manuscript file attached."
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>
                    <Border Background="White"
                            CornerRadius="8"
                            Padding="14"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                        <TextBlock x:Name="DescriptionTextBlock"
                                   Text="Description content..."
                                   FontSize="13"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="2"
                    Content="Close"
                    Width="100" Height="38"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Background="#E5E7EB"
                    Foreground="#374151"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
